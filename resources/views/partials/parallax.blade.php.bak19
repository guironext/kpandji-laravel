@php
  $real = fn ($p) => $p && ! str_ends_with($p, '.svg') && file_exists(public_path($p));
  $wanted = collect(content('parallax.cars'))->pluck('slug')->filter()->values();
  $pool = $cars->filter(fn ($c) => $real($c->image));
  $scenes = $wanted->isNotEmpty() ? $wanted->map(fn ($s) => $pool->firstWhere('slug', $s))->filter()->values() : $pool->take(4)->values();
  $gallery = $cars->flatMap(fn ($c) => [[$c->hero_image, $c->name], [$c->image, $c->name]])->filter(fn ($g) => $real($g[0]))->unique(fn ($g) => $g[0])->values();
@endphp
