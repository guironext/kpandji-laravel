    <div data-qbg class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_60%_at_50%_50%,rgba(201,169,98,0.22),transparent_70%)]"></div>
    <p data-qname class="kp-px-name pointer-events-none absolute left-1/2 top-1/2 w-max -translate-x-1/2 -translate-y-1/2 whitespace-nowrap font-serif font-semibold uppercase leading-none opacity-80" aria-hidden="true">KPANDJI</p>
    <div class="relative mx-auto max-w-5xl px-5 text-center" :class="quoteIn && 'is-in'">
      <span class="kp-px-q mx-auto block h-px w-24 bg-gradient-to-r from-transparent via-kp-gold to-transparent" style="--r:0"></span>
      <blockquote class="kp-px-q mt-8 font-serif text-4xl italic leading-tight text-white md:text-6xl" style="--r:1">« @content('parallax.quote') »</blockquote>
      <p class="kp-px-q mt-6 text-sm uppercase tracking-[0.3em] text-white/55" style="--r:2">@content('parallax.quote_sub')</p>
      <a href="{{ cms_url(content('parallax.quote_url')) }}" class="kp-px-q kp-cta-pulse relative mt-10 inline-flex rounded-full bg-gradient-to-r from-[#e3c77f] via-kp-gold to-[#a8863f] px-10 py-4 text-xs font-bold uppercase tracking-[0.22em] text-black" style="--r:3">@content('parallax.quote_cta')</a>
    </div>
  </div>
</section>
<script>
function kpParallax() {
  return {
    staticMode: false, quoteIn: false,
    init() {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { this.staticMode = true; this.quoteIn = true; return }
      const k = matchMedia('(max-width: 767px)').matches ? 0.5 : 1;   // parallaxe allégée sur mobile
      const scenes = [...this.$el.querySelectorAll('[data-scene]')], dots = [...this.$el.querySelectorAll('[data-dot]')];
      const streaks = this.$el.querySelector('.kp-px-streaks'), qname = this.$el.querySelector('[data-qname]'), qbg = this.$el.querySelector('[data-qbg]');
      const S = this.$refs.scenes, G = this.$refs.gal, strip = this.$refs.strip, Q = this.$refs.quote;
      const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
      let ticking = false, visible = true;
      const frame = () => {
        ticking = false; const vh = innerHeight;
        // scènes
        const r = S.getBoundingClientRect(), span = r.height - vh, n = scenes.length;
        const prog = clamp(-r.top / span, 0, 1), p = prog * (n - 1);
        scenes.forEach((el, i) => {
          const d = p - i, a = Math.abs(d);
          el.style.opacity = clamp(1 - a * 1.7, 0, 1);
          el.style.transform = `translate3d(${(-d * 10 * k).toFixed(2)}vw,0,0)`;
          el.style.visibility = a > 0.9 ? 'hidden' : 'visible';
          el.classList.toggle('is-active', a < 0.35);
          const nm = el.querySelector('[data-layer="name"]'), car = el.querySelector('[data-layer="car"]');
          nm.style.transform = `translate3d(${(4 - d * 14 * k).toFixed(2)}vw,-50%,0)`;
          car.style.transform = `translate3d(${(-d * 38 * k).toFixed(2)}vw,${(a * 4 * k).toFixed(2)}vh,0) scale(${(1.04 - a * 0.12).toFixed(3)}) rotate(${(-d * 3 * k).toFixed(2)}deg)`;
        });
        dots.forEach((dt, i) => dt.classList.toggle('on', Math.round(p) === i));
        this.$refs.bar.style.transform = `scaleX(${prog.toFixed(4)})`;
        streaks.style.transform = `translate3d(${(-prog * 30 * k).toFixed(2)}vw,0,0)`;
        // galerie
        if (G && strip) {
          const g = G.getBoundingClientRect(), gp = clamp(-g.top / (g.height - vh), 0, 1);
          const max = Math.max(0, strip.scrollWidth - innerWidth);
          strip.style.transform = `translate3d(${(-gp * max).toFixed(1)}px,0,0)`;
        }
        // citation
        const q = Q.getBoundingClientRect(), qp = clamp(1 - (q.top + q.height / 2) / (vh + q.height / 2), 0, 1);
        qname.style.transform = `translate3d(calc(-50% + ${((0.5 - qp) * 30 * k).toFixed(2)}vw),-50%,0)`;
        qbg.style.transform = `scale(${(0.9 + qp * 0.3).toFixed(3)})`;
      };
      const onScroll = () => { if (visible && !ticking) { ticking = true; requestAnimationFrame(frame) } };
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) onScroll() }, { rootMargin: '200px 0px' }).observe(this.$el);
      new IntersectionObserver(([e]) => { if (e.isIntersecting) this.quoteIn = true; else if (e.boundingClientRect.top > 0) this.quoteIn = false }, { threshold: 0.35 }).observe(Q);
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      frame();
    },
  }
}
</script>
@endif
