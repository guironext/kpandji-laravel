<script>
// Reveal (équivalent de components/kp/Reveal.tsx) : fondu + montée de 40px, une seule fois
(() => {
  const els = document.querySelectorAll('[data-kp-reveal]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  els.forEach(el => el.classList.add('kp-reveal-wait'));
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('kp-reveal-in'); io.unobserve(e.target) } }), { threshold: 0.14 });
  els.forEach(el => io.observe(el));
})();
</script>
